# Example Local Development Configuration
# Copy this file to application-local.properties to override settings for your local machine.
# application-local.properties is git-ignored and will never be committed.

server.port=5656

# Change this to match your local MySQL server (port 3306 or 3307)
spring.datasource.url=jdbc:mysql://localhost:3307/stocksmart?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_local_mysql_password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Safe 256-bit secret key for local development only
jwt.secret=local_dev_secret_key_change_in_production_min_32_bytes_123456
jwt.expiration=86400000

cors.allowed-origins=http://localhost:4200,http://localhost:5173
